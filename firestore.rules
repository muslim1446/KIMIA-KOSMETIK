rules_version = '2';

// ============================================================================
// KIMIA 5.4 — OPEN-WORLD RULES
// ----------------------------------------------------------------------------
// Goal: zero login, zero permission friction. Every connected device can read
// and write every note, PDF, image, stroke and heartbeat immediately.
//   * No anonymous / Google sign-in gate.
//   * No room membership gate.
//   * No join-code check.
//
// Data-loss guarantee: the room shell and the per-slide history documents can
// NEVER be deleted, so no single visitor (or accident) can wipe the team's
// presentation. Individual notes / PDFs / images / heartbeats can still be
// removed normally by the app's own delete buttons.
//
// If you ever want to allow deleting the room and slide history too, change
// the three `allow delete: if false;` lines below to `if true;`.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      // Anyone can read, create and update the room with no authentication.
      allow read, create, update: if true;
      // The room shell can never be deleted — protects the whole presentation.
      allow delete: if false;

      match /members/{memberId} {
        allow read, create, update: if true;
        allow delete: if true; // a guest may leave / be removed
      }

      match /slides/{slideKey} {
        allow read, create, update: if true;
        allow delete: if false; // stroke + text-edit history is permanent
      }

      match /ephemeral/{slideKey} {
        allow read, create, update: if true;
        allow delete: if false; // live / ephemeral board is permanent
      }

      match /images/{imageId} {
        allow read, create, update, delete: if true;
      }

      match /texts/{textId} {
        allow read, create, update, delete: if true;
      }

      match /pdfPages/{pdfId} {
        allow read, create, update, delete: if true;
      }

      // Original PDF files uploaded to Storage. Kept permanent so a shared
      // document can never be wiped from under another device.
      match /pdfLibrary/{fileId} {
        allow read, create, update: if true;
        allow delete: if false;
      }

      match /presence/{userId} {
        allow read, create, update, delete: if true;
      }
    }

    // Fallback for anything else that may ever be written: stays open for
    // read / create / update (but is never deletable by default).
    match /{document=**} {
      allow read, create, update: if true;
    }
  }
}
